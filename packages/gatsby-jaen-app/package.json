{
  "name": "gatsby-jaen-app",
  "version": "1.9.2",
  "description": "App plugin for Jaen",
  "keywords": [
    "gatsby"
  ],
  "main": "index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "src",
    "shared",
    "client",
    "dist",
    "gatsby-node.js",
    "gatsby-config.js",
    "gatsby-browser.tsx",
    "gatsby-ssr.tsx"
  ],
  "scripts": {
    "build": "tsc gatsby/gatsby-config.ts gatsby/gatsby-node.ts gatsby/gatsby-browser.ts --outDir dist/gatsby --esModuleInterop --skipLibCheck --resolveJsonModule --noCheck && tsc -p tsconfig.build.json --noCheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gqty/react": "^3.0.5",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@react-icons/all-files": "https://github.com/react-icons/react-icons/releases/download/v4.11.0/react-icons-all-files-4.11.0.tgz",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "gatsby-plugin-offline": "^6.15.0",
    "gqty": "^3.2.2",
    "mapbox-gl": "^3.19.0",
    "oidc-client-ts": "^2.4.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.11.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.11.0",
    "gatsby": "^5.12.4",
    "gatsby-plugin-jaen": "^1.0.0",
    "jaen": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
